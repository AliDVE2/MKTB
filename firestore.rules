rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== دوال مساعدة =====
    function signed() { return request.auth != null; }
    function mail()   { return request.auth.token.email; }

    // الادمن الرئيسي (سجل بحسابه اول شي حتى ما احد ثاني ياخذ الايميل)
    function isAdmin() {
      return signed()
        && mail() == 'asdefu781@gmail.com';
    }

    function staffRole() {
      return exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        ? get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role
        : '';
    }

    function isManager() {
      return isAdmin()
        || (signed() && staffRole() == 'manager');
    }

    function isStaff() {
      return isManager()
        || (signed() && staffRole() == 'assistant');
    }

    // ===== اعدادات المتجر =====
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===== الاقسام والمنتجات =====
    match /categories/{id} {
      allow read: if signed();
      allow write: if isManager();
    }
    match /products/{id} {
      allow read: if signed();
      allow write: if isManager();
    }

    // ===== المستخدمين =====
    match /users/{uid} {
      allow read: if signed() && (request.auth.uid == uid || isStaff());
      allow create, update: if signed()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'phone', 'createdAt'])
        && request.resource.data.email == mail();
      allow delete: if isAdmin();
    }

    // ===== فريق العمل (مدير / معاون) =====
    match /staff/{uid} {
      allow read: if isAdmin() || (signed() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // ===== الطلبات =====
    match /orders/{id} {
      allow read: if signed() && (resource.data.uid == request.auth.uid || isStaff());
      allow create: if signed()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'جديد'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50;
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ===== البلاغات =====
    match /reports/{id} {
      allow create: if signed()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000;
      allow read, update: if isStaff();
      allow delete: if isAdmin();
    }

    // اي شي ثاني ممنوع
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
